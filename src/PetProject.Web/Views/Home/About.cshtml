@{
    ViewData["Title"] = "About Us";
}

<header class="page-header text-center" style="padding: 4rem 0; background-color: #f3e5f5;">
    <div class="container">
        <h1 class="text-primary">About Us</h1>
        <p>We treat your pets like family.</p>
    </div>
</header>

<section class="section" style="padding: 4rem 0;">
    <div class="container grid grid-cols-2 gap-lg items-center">
        <div>
            <h2 class="text-primary" style="margin-bottom: 1.5rem;">Our Story</h2>
            <p style="margin-bottom: 1rem;">Founded in 2020, PetCare was born out of a passion for animals and a desire to provide the best possible care for pets in our community.</p>
            <p style="margin-bottom: 1rem;">Our team of experienced veterinarians and staff are dedicated to ensuring your pet's health and happiness. We offer a wide range of services from routine checkups to emergency care.</p>
            <ul style="list-style: none; padding: 0; margin-top: 2rem;">
                <li style="margin-bottom: 0.5rem;"><i class="fa-solid fa-check text-success"></i> Certified Veterinarians</li>
                <li style="margin-bottom: 0.5rem;"><i class="fa-solid fa-check text-success"></i> Modern Facilities</li>
                <li style="margin-bottom: 0.5rem;"><i class="fa-solid fa-check text-success"></i> 24/7 Emergency Support</li>
            </ul>
        </div>
        <div>
            <img src="https://images.unsplash.com/photo-1599443015574-be5fe8a05783?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="About Us" class="rounded shadow" style="width: 100%;">
        </div>
    </div>
</section>
