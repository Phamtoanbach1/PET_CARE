@model IEnumerable<PetProject.Application.DTOs.ServiceListDto>
@{
    ViewData["Title"] = "Our Services";
}

<header class="page-header text-center" style="padding: 4rem 0; background-color: #e0f7fa;">
    <div class="container">
        <h1 class="text-primary">Our Services</h1>
        <p>Comprehensive care for your beloved pets.</p>
    </div>
</header>

<section class="section" style="padding: 4rem 0;">
    <div class="container">
        <div class="grid grid-cols-3 gap-lg">
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <div class="card text-center">
                        <div class="icon-box" style="width: 80px; height: 80px; background: #e0f7fa; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
                            <i class="fa-solid fa-paw text-primary" style="font-size: 2rem;"></i>
                        </div>
                        <h3>@item.Name</h3>
                        <p class="text-light">@item.Description</p>
                        <p class="text-primary" style="font-weight: 700; font-size: 1.25rem; margin: 1rem 0;">$@item.Price</p>
                        <p><i class="fa-regular fa-clock"></i> @item.DurationMinutes mins</p>
                        <a asp-controller="Booking" asp-action="Index" class="btn btn-primary" style="margin-top: 1rem;">Book Now</a>
                    </div>
                }
            }
            else
            {
                <p>No services available at the moment.</p>
            }
        </div>
    </div>
</section>
