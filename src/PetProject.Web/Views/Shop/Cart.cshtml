@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container" style="padding: 4rem 0;">
    <h1 class="text-primary" style="margin-bottom: 2rem;">Shopping Cart</h1>

    <div class="grid grid-cols-3 gap-lg">
        <div class="col-span-2">
            <div class="card">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid #eee;">
                            <th style="text-align: left; padding: 1rem;">Product</th>
                            <th style="padding: 1rem;">Price</th>
                            <th style="padding: 1rem;">Quantity</th>
                            <th style="padding: 1rem;">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Static Item for Demo -->
                        <tr style="border-bottom: 1px solid #eee;">
                            <td style="padding: 1rem;">
                                <div class="flex items-center gap-sm">
                                    <div style="width: 50px; height: 50px; background: #ddd; border-radius: 4px;"></div>
                                    <span>Premium Dog Food</span>
                                </div>
                            </td>
                            <td style="padding: 1rem; text-align: center;">$25.00</td>
                            <td style="padding: 1rem; text-align: center;">
                                <input type="number" value="1" class="input" style="width: 60px; padding: 0.25rem;">
                            </td>
                            <td style="padding: 1rem; text-align: center;">$25.00</td>
                            <td style="padding: 1rem; text-align: center;">
                                <button class="text-danger" style="background: none; border: none; cursor: pointer;"><i class="fa-solid fa-trash"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div>
            <div class="card">
                <h3 style="margin-bottom: 1rem;">Summary</h3>
                <div class="flex justify-between" style="margin-bottom: 0.5rem;">
                    <span>Subtotal</span>
                    <span>$25.00</span>
                </div>
                <div class="flex justify-between" style="margin-bottom: 1rem;">
                    <span>Shipping</span>
                    <span>Free</span>
                </div>
                <div class="flex justify-between" style="margin-bottom: 1rem; font-weight: 700; font-size: 1.25rem;">
                    <span>Total</span>
                    <span class="text-primary">$25.00</span>
                </div>
                <button class="btn btn-primary" style="width: 100%;">Checkout</button>
            </div>
        </div>
    </div>
</div>
