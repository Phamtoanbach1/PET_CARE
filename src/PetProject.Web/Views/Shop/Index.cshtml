@model IEnumerable<PetProject.Application.DTOs.ProductListDto>
@{
    ViewData["Title"] = "Shop";
}

<header class="page-header text-center" style="padding: 4rem 0; background-color: #fff3e0;">
    <div class="container">
        <h1>Pet Shop</h1>
        <p>Quality food, toys, and accessories for your furry friends.</p>
    </div>
</header>

<section class="shop-content section" style="padding: 4rem 0;">
    <div class="container flex gap-lg" style="align-items: flex-start;">

        <!-- Sidebar Filters -->
        <aside class="sidebar" style="flex: 0 0 250px;">
            <div class="card">
                <h3 style="margin-bottom: 1rem;">Categories</h3>
                <ul style="margin-bottom: 2rem;">
                    <li style="margin-bottom: 0.5rem;"><a href="#" class="text-primary">All Products</a></li>
                    <li style="margin-bottom: 0.5rem;"><a href="#">Food & Treats</a></li>
                    <li style="margin-bottom: 0.5rem;"><a href="#">Toys</a></li>
                    <li style="margin-bottom: 0.5rem;"><a href="#">Accessories</a></li>
                    <li style="margin-bottom: 0.5rem;"><a href="#">Healthcare</a></li>
                </ul>

                <h3 style="margin-bottom: 1rem;">Price Range</h3>
                <div class="flex items-center gap-sm" style="margin-bottom: 1rem;">
                    <input type="number" class="input" placeholder="Min" style="width: 80px;">
                    <span>-</span>
                    <input type="number" class="input" placeholder="Max" style="width: 80px;">
                </div>
                <button class="btn btn-outline" style="width: 100%;">Filter</button>
            </div>
        </aside>

        <!-- Product Grid -->
        <div class="product-grid" style="flex: 1;">
            <div class="grid grid-cols-3 gap-md">
                @foreach (var item in Model)
                {
                    <div class="card">
                        <a asp-action="Details" asp-route-id="@item.Id">
                            <img src="@item.ImageUrl" alt="@item.Name" class="rounded" style="width: 100%; height: 200px; object-fit: cover; margin-bottom: 1rem;">
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" style="text-decoration: none; color: inherit;">
                            <h3 style="font-size: 1.25rem;">@item.Name</h3>
                        </a>
                        <p class="text-light" style="font-size: 0.9rem;">@item.Description</p>
                        <div class="flex justify-between items-center" style="margin-top: 1rem;">
                            <span class="price text-primary" style="font-weight: 700; font-size: 1.25rem;">$@item.Price</span>
                            <button class="btn btn-sm btn-primary" style="padding: 0.5rem 1rem;"><i class="fa-solid fa-cart-plus"></i></button>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            <div class="flex justify-center gap-sm" style="margin-top: 3rem;">
                <button class="btn btn-outline" disabled>&lt;</button>
                <button class="btn btn-primary">1</button>
                <button class="btn btn-outline">2</button>
                <button class="btn btn-outline">3</button>
                <button class="btn btn-outline">&gt;</button>
            </div>
        </div>
    </div>
</section>
