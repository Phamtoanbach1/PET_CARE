@model PetProject.Application.DTOs.RegisterDto
@{
    ViewData["Title"] = "Register";
}

<div class="container" style="max-width: 400px; padding: 4rem 1rem;">
    <div class="card">
        <h2 class="text-center text-primary" style="margin-bottom: 2rem;">Register</h2>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div style="margin-bottom: 1rem;">
                <label asp-for="FullName" style="display: block; margin-bottom: 0.5rem;">Full Name</label>
                <input asp-for="FullName" class="input" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div style="margin-bottom: 1rem;">
                <label asp-for="Email" style="display: block; margin-bottom: 0.5rem;">Email</label>
                <input asp-for="Email" class="input" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div style="margin-bottom: 1rem;">
                <label asp-for="Password" style="display: block; margin-bottom: 0.5rem;">Password</label>
                <input asp-for="Password" type="password" class="input" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div style="margin-bottom: 1rem;">
                <label asp-for="ConfirmPassword" style="display: block; margin-bottom: 0.5rem;">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="input" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">Register</button>
        </form>
        <div class="text-center" style="margin-top: 1rem;">
            <a asp-action="Login">Already have an account? Login</a>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
